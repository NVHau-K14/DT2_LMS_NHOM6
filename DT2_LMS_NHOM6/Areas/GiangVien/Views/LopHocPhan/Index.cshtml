@model LopHocPhanViewModel
@{
    ViewData["Title"] = "Lớp học phần";
}

<div class="the-noi-dung">
    <div class="thanh-cong-cu justify-content-end">
        <form method="get" class="thanh-loc">
            <select class="form-select" id="ky" name="ky" aria-label="Học kỳ" data-tu-gui>
                <option value="">Tất cả học kỳ</option>
                @foreach (var (nam, ky) in Model.DsHocKy)
                {
                    var ma = LopHocPhanViewModel.MaKy(nam, ky);
                    <option value="@ma" selected="@(ma == Model.KyChon)">@HienThi.HocKy(nam, ky)</option>
                }
            </select>
        </form>
    </div>

    @if (Model.DanhSach.Count == 0)
    {
        <partial name="_TrangTrong" model='new TrangTrongViewModel("Không có lớp học phần", null, "bi-collection")' />
    }
    else
    {
        <div class="khung-bang table-responsive">
            <table class="table bang-du-lieu">
                <thead>
                    <tr>
                        <th>Học kỳ</th>
                        <th>Mã môn</th>
                        <th>Tên môn</th>
                        <th class="text-center">TC</th>
                        <th class="text-center" title="Chuyên cần / Giữa kỳ / Cuối kỳ (%)">Trọng số</th>
                        <th>Lớp</th>
                        <th class="text-center">Sĩ số</th>
                        <th style="min-width: 160px">Đã đủ điểm</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.DanhSach)
                    {
                        var phanTram = LopHocPhanViewModel.PhanTramTienDo(l);
                        <tr>
                            <td class="text-nowrap">@HienThi.HocKy(l.NamHoc, l.HocKy)</td>
                            <td class="ma">@l.MaMon</td>
                            <td>@l.TenMon</td>
                            <td class="text-center">@l.SoTinChi</td>
                            <td class="text-center">@l.TrongSo.Cc/@l.TrongSo.Gk/@l.TrongSo.Ck</td>
                            <td class="text-nowrap">
                                @foreach (var lop in l.CacLop)
                                {
                                    <div>@lop</div>
                                }
                            </td>
                            <td class="text-center">@l.SiSo</td>
                            <td>
                                <div class="tien-do-hang">
                                    <div class="progress tien-do @(phanTram == 100 ? "xong" : "")" role="progressbar" aria-valuenow="@phanTram" aria-valuemin="0" aria-valuemax="100" aria-label="Tiến độ nhập điểm">
                                        <div class="progress-bar" style="width: @phanTram%"></div>
                                    </div>
                                    <span class="small text-nowrap">@l.SoDuDiem/@l.SiSo</span>
                                </div>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-primary text-nowrap"
                                   href="/GiangVien/NhapDiem?maMon=@Uri.EscapeDataString(l.MaMon)&namHoc=@Uri.EscapeDataString(l.NamHoc)&hocKy=@l.HocKy">
                                    <i class="bi bi-pencil-square me-1"></i>Nhập điểm
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
