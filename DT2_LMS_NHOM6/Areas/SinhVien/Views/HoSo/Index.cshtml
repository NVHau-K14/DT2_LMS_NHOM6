@model HoSoCaNhanViewModel
@{
    ViewData["Title"] = "Thông tin sinh viên";
    var sv = Model.SinhVien;
}

<div class="row g-3">
    <div class="col-xl-8">
        <div class="the-noi-dung h-100">
            <div class="the-sinh-vien">
                <div class="anh-dai-dien-sv" aria-hidden="true"><i class="bi bi-person-fill"></i></div>
                <dl class="danh-sach-thong-tin flex-grow-1">
                    <dt>MSSV</dt><dd class="ma">@sv.MaSV</dd>
                    <dt>Họ tên</dt><dd>@sv.HoTen</dd>
                    <dt>Trạng thái</dt><dd><span class="badge badge-trang-thai @HienThi.LopBadgeTrangThai(sv.TrangThai)">@sv.TrangThai</span></dd>
                    <dt>Ngày sinh</dt><dd>@HienThi.Ngay(sv.NgaySinh)</dd>
                    <dt>Giới tính</dt><dd>@sv.GioiTinh</dd>
                    <dt>Email</dt><dd>@(sv.Email ?? "–")</dd>
                    <dt>Số điện thoại</dt><dd>@(sv.SoDienThoai ?? "–")</dd>
                    <dt>Địa chỉ</dt><dd>@(sv.DiaChi ?? "–")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="the-noi-dung h-100">
            <h2 class="h6 text-secondary mb-3">Lớp sinh hoạt</h2>
            <dl class="danh-sach-thong-tin">
                <dt>Mã lớp</dt><dd class="ma">@sv.MaLop</dd>
                @if (Model.Lop != null)
                {
                    <dt>Tên lớp</dt><dd>@Model.Lop.TenLop</dd>
                    <dt>Niên khóa</dt><dd>@Model.Lop.NienKhoa</dd>
                    <dt>Ngành</dt><dd>@Model.Lop.Nganh</dd>
                    <dt>Khoa</dt><dd>@Model.Lop.Khoa</dd>
                    <dt>Cố vấn học tập</dt><dd>@(Model.Lop.CoVanHocTap?.HoTen ?? "Chưa phân công")</dd>
                }
            </dl>
        </div>
    </div>
</div>
