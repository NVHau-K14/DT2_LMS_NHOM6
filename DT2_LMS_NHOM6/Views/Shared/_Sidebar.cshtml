@*
    Sidebar trái: logo + menu theo vai trò (thiết kế mục 5.2–5.4).
    Menu dùng URL cứng theo area/controller (mọi mục đều đã có trang).
    Mục đang mở được đánh dấu active theo area + controller hiện tại.
    Admin có thêm link "API" tới Swagger (chỉ ở môi trường Development – Swagger chỉ bật ở đó).
*@
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment MoiTruong
@{
    var vaiTro = User.VaiTro();
    var areaHienTai = ViewContext.RouteData.Values["area"] as string ?? "";
    var controllerHienTai = ViewContext.RouteData.Values["controller"] as string ?? "";

    // (Tên hiển thị, icon Bootstrap Icons, area, controller)
    (string Ten, string Icon, string Area, string Controller)[] menu = vaiTro switch
    {
        HangSo.VaiTro.Admin =>
        [
            ("Tổng quan", "bi-speedometer2", "Admin", "Home"),
            ("Lớp học", "bi-people", "Admin", "LopHoc"),
            ("Sinh viên", "bi-person-vcard", "Admin", "SinhVien"),
            ("Giảng viên", "bi-person-workspace", "Admin", "GiangVien"),
            ("Môn học", "bi-journal-bookmark", "Admin", "MonHoc"),
            ("Ghi danh", "bi-person-plus", "Admin", "GhiDanh"),
            ("Báo cáo học lực", "bi-bar-chart-line", "Admin", "BaoCao"),
            ("Nhập/Xuất dữ liệu", "bi-file-earmark-spreadsheet", "Admin", "DuLieu"),
            ("Hiệu năng", "bi-lightning-charge", "Admin", "HieuNang")
        ],
        HangSo.VaiTro.GiangVien =>
        [
            ("Tổng quan", "bi-speedometer2", "GiangVien", "Home"),
            ("Lớp học phần", "bi-collection", "GiangVien", "LopHocPhan"),
            ("Báo cáo học lực", "bi-bar-chart-line", "GiangVien", "BaoCao")
        ],
        HangSo.VaiTro.SinhVien =>
        [
            ("Tổng quan", "bi-speedometer2", "SinhVien", "Home"),
            ("Kết quả học tập", "bi-journal-check", "SinhVien", "KetQua"),
            ("Thông tin sinh viên", "bi-person-badge", "SinhVien", "HoSo")
        ],
        _ => []
    };
}
<aside class="sidebar" id="sidebar">
    <a class="sidebar-logo" href="@User.TrangChuTheoVaiTro()">
        <span class="logo-icon"><i class="bi bi-mortarboard-fill"></i></span>
        <span class="logo-chu">
            <span class="logo-ten">EduScore</span>
            <span class="logo-phu">Cổng Quản lý Học tập</span>
        </span>
    </a>

    <div class="sidebar-nhom">@HienThi.TenVaiTro(vaiTro)</div>
    <nav class="sidebar-menu">
        @foreach (var muc in menu)
        {
            var url = muc.Controller == "Home" ? $"/{muc.Area}" : $"/{muc.Area}/{muc.Controller}";
            var active = string.Equals(areaHienTai, muc.Area, StringComparison.OrdinalIgnoreCase)
                         && string.Equals(controllerHienTai, muc.Controller, StringComparison.OrdinalIgnoreCase);
            <a class="sidebar-muc @(active ? "active" : "")" href="@Url.Content("~" + url)" title="@muc.Ten">
                <i class="bi @muc.Icon"></i><span>@muc.Ten</span>
            </a>
        }
        @if (vaiTro == HangSo.VaiTro.Admin && MoiTruong.IsDevelopment())
        {
            <a class="sidebar-muc" href="@Url.Content("~/swagger")" target="_blank" rel="noopener" title="API (Swagger)">
                <i class="bi bi-braces"></i><span>API</span>
            </a>
        }
    </nav>
</aside>
