@*
    Hộp xác nhận dùng chung (xóa, reset mật khẩu, khóa tài khoản...). Nút kích hoạt:
      <button type="button" class="btn btn-danger" data-xac-nhan-xoa
              data-url="/Admin/LopHoc/Xoa/CNTT2501" data-noi-dung="Xóa lớp 16DHTH01?">Xóa</button>
    Tùy chọn: data-tieu-de (mặc định "Xác nhận xóa"), data-nut (mặc định "Xóa"),
              data-ghi-chu (mặc định "Thao tác này không thể hoàn tác.").
    Khi xác nhận, form POST (có antiforgery token) được gửi tới data-url.
*@
<div class="modal fade" id="modal-xac-nhan-xoa" tabindex="-1" aria-labelledby="modal-xac-nhan-xoa-tieu-de" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" id="form-xac-nhan-xoa">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title h5">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i><span id="modal-xac-nhan-xoa-tieu-de">Xác nhận xóa</span>
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1" id="xac-nhan-xoa-noi-dung">Bạn có chắc chắn muốn xóa mục này?</p>
                    <p class="small text-secondary mb-0" id="xac-nhan-xoa-ghi-chu">Thao tác này không thể hoàn tác.</p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-check2 me-1"></i><span id="xac-nhan-xoa-nut">Xóa</span></button>
                </div>
            </form>
        </div>
    </div>
</div>
