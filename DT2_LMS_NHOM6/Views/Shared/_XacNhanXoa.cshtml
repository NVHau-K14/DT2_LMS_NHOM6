@*
    Hộp xác nhận xóa dùng chung. Nút kích hoạt:
      <button type="button" class="btn btn-danger" data-xac-nhan-xoa
              data-url="/Admin/LopHoc/Xoa/16DHTH01" data-noi-dung="Xóa lớp 16DHTH01?">Xóa</button>
    Khi xác nhận, form POST (có antiforgery token) được gửi tới data-url.
*@
<div class="modal fade" id="modal-xac-nhan-xoa" tabindex="-1" aria-labelledby="modal-xac-nhan-xoa-tieu-de" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" id="form-xac-nhan-xoa">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title h5" id="modal-xac-nhan-xoa-tieu-de">
                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>Xác nhận xóa
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1" id="xac-nhan-xoa-noi-dung">Bạn có chắc chắn muốn xóa mục này?</p>
                    <p class="small text-secondary mb-0">Thao tác này không thể hoàn tác.</p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Xóa</button>
                </div>
            </form>
        </div>
    </div>
</div>
