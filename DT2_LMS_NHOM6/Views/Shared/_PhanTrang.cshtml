@model PhanTrangViewModel
@*
    Phân trang phía server. Hiện "Hiển thị 21–40 / 100" và các nút trang (tối đa 7 số quanh trang hiện tại).
    Link giữ nguyên bộ lọc hiện tại (Model.ThamSo) và thêm ?page=n.
*@
@{
    var tu = Math.Max(1, Model.Trang - 3);
    var den = Math.Min(Model.TongSoTrang, Model.Trang + 3);
}
<div class="phan-trang">
    <div>Hiển thị <strong>@Model.TuDong–@Model.DenDong</strong> / @Model.TongSo dòng</div>
    @if (Model.TongSoTrang > 1)
    {
        <nav aria-label="Phân trang">
            <ul class="pagination pagination-sm">
                <li class="page-item @(Model.Trang == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Model.UrlTrang(Model.Trang - 1)" aria-label="Trang trước"><i class="bi bi-chevron-left"></i></a>
                </li>
                @if (tu > 1)
                {
                    <li class="page-item"><a class="page-link" href="@Model.UrlTrang(1)">1</a></li>
                    if (tu > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                }
                @for (var i = tu; i <= den; i++)
                {
                    <li class="page-item @(i == Model.Trang ? "active" : "")" aria-current="@(i == Model.Trang ? "page" : null)">
                        <a class="page-link" href="@Model.UrlTrang(i)">@i</a>
                    </li>
                }
                @if (den < Model.TongSoTrang)
                {
                    if (den < Model.TongSoTrang - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                    <li class="page-item"><a class="page-link" href="@Model.UrlTrang(Model.TongSoTrang)">@Model.TongSoTrang</a></li>
                }
                <li class="page-item @(Model.Trang == Model.TongSoTrang ? "disabled" : "")">
                    <a class="page-link" href="@Model.UrlTrang(Model.Trang + 1)" aria-label="Trang sau"><i class="bi bi-chevron-right"></i></a>
                </li>
            </ul>
        </nav>
    }
</div>
