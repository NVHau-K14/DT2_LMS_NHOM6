@using Microsoft.Extensions.Options
@inject IOptions<HocKyHienTaiOptions> HocKyHienTai
@{
    var tieuDe = ViewData["Title"] as string ?? "EduScore";
    var hocKy = HocKyHienTai.Value;
    var vaiTro = User.VaiTro();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@tieuDe – EduScore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="eduscore">
    @* Áp dụng trạng thái sidebar thu gọn đã lưu trước khi vẽ trang để không bị nháy *@
    <script>try { if (localStorage.getItem('eduscore.sidebarThuGon') === '1') document.body.classList.add('sidebar-thu-gon'); } catch (e) { }</script>

    <partial name="_Sidebar" />
    <div class="sidebar-nen-mo" data-sidebar-dong></div>

    <div class="khung-chinh">
        <header class="thanh-dau">
            <button type="button" class="btn btn-icon" data-sidebar-bat title="Thu gọn / mở menu" aria-label="Thu gọn hoặc mở menu">
                <i class="bi bi-list"></i>
            </button>

            <div class="thanh-dau-tieu-de">
                <h1 class="tieu-de-trang">@tieuDe</h1>
            </div>

            <div class="thanh-dau-phai">
                <span class="nhan-hoc-ky" title="Học kỳ hiện tại">
                    <i class="bi bi-calendar3"></i> @HienThi.HocKy(hocKy.NamHoc, hocKy.HocKy)
                </span>

                <div class="dropdown">
                    <button class="btn nguoi-dung dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="anh-dai-dien"><i class="bi bi-person-fill"></i></span>
                        <span class="nguoi-dung-ten d-none d-md-inline">@User.HoTen()</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        @* Sinh viên: dropdown chỉ còn Đổi mật khẩu + Đăng xuất (thông tin đã có ở trang Tổng quan) *@
                        @if (vaiTro != HangSo.VaiTro.SinhVien)
                        {
                            <li class="px-3 py-2">
                                <div class="fw-semibold">@User.HoTen()</div>
                                <div class="small text-secondary">@HienThi.TenVaiTro(vaiTro) · @User.TenDangNhap()</div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                        }
                        <li>
                            <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="DoiMatKhau">
                                <i class="bi bi-key me-2"></i>Đổi mật khẩu
                            </a>
                        </li>
                        <li>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" id="form-dang-xuat">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="noi-dung" role="main">
            @RenderBody()
        </main>

        <footer class="chan-trang">© 2026 Cổng Quản lý Học tập – EduScore</footer>
    </div>

    <partial name="_Toast" />
    <partial name="_XacNhanXoa" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/eduscore.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
