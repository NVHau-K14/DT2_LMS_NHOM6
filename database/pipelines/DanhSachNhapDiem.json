[
  {
    "$match": {
      "monHoc": {
        "$elemMatch": {
          "giangVien.maGV": "GV005",
          "maMon": "INT301",
          "namHoc": "2026-2027",
          "hocKy": 1
        }
      }
    }
  },
  {
    "$unwind": "$monHoc"
  },
  {
    "$match": {
      "monHoc.giangVien.maGV": "GV005",
      "monHoc.maMon": "INT301",
      "monHoc.namHoc": "2026-2027",
      "monHoc.hocKy": 1
    }
  },
  {
    "$addFields": {
      "monHoc.duDiem": {
        "$and": [
          {
            "$ne": [
              {
                "$ifNull": [
                  "$monHoc.diem.cc",
                  null
                ]
              },
              null
            ]
          },
          {
            "$ne": [
              {
                "$ifNull": [
                  "$monHoc.diem.gk",
                  null
                ]
              },
              null
            ]
          },
          {
            "$ne": [
              {
                "$ifNull": [
                  "$monHoc.diem.ck",
                  null
                ]
              },
              null
            ]
          }
        ]
      }
    }
  },
  {
    "$addFields": {
      "monHoc.diemTK": {
        "$cond": [
          "$monHoc.duDiem",
          {
            "$divide": [
              {
                "$floor": {
                  "$add": [
                    {
                      "$divide": [
                        {
                          "$add": [
                            {
                              "$multiply": [
                                "$monHoc.diem.cc",
                                "$monHoc.trongSo.cc"
                              ]
                            },
                            {
                              "$multiply": [
                                "$monHoc.diem.gk",
                                "$monHoc.trongSo.gk"
                              ]
                            },
                            {
                              "$multiply": [
                                "$monHoc.diem.ck",
                                "$monHoc.trongSo.ck"
                              ]
                            }
                          ]
                        },
                        10
                      ]
                    },
                    0.5000001
                  ]
                }
              },
              10
            ]
          },
          null
        ]
      }
    }
  },
  {
    "$addFields": {
      "monHoc.diemChu": {
        "$switch": {
          "branches": [
            {
              "case": {
                "$eq": [
                  "$monHoc.diemTK",
                  null
                ]
              },
              "then": null
            },
            {
              "case": {
                "$gte": [
                  "$monHoc.diemTK",
                  8.5
                ]
              },
              "then": "A"
            },
            {
              "case": {
                "$gte": [
                  "$monHoc.diemTK",
                  7.0
                ]
              },
              "then": "B"
            },
            {
              "case": {
                "$gte": [
                  "$monHoc.diemTK",
                  5.5
                ]
              },
              "then": "C"
            },
            {
              "case": {
                "$gte": [
                  "$monHoc.diemTK",
                  4.0
                ]
              },
              "then": "D"
            }
          ],
          "default": "F"
        }
      }
    }
  },
  {
    "$addFields": {
      "monHoc.diemHe4": {
        "$switch": {
          "branches": [
            {
              "case": {
                "$eq": [
                  "$monHoc.diemChu",
                  "A"
                ]
              },
              "then": 4
            },
            {
              "case": {
                "$eq": [
                  "$monHoc.diemChu",
                  "B"
                ]
              },
              "then": 3
            },
            {
              "case": {
                "$eq": [
                  "$monHoc.diemChu",
                  "C"
                ]
              },
              "then": 2
            },
            {
              "case": {
                "$eq": [
                  "$monHoc.diemChu",
                  "D"
                ]
              },
              "then": 1
            },
            {
              "case": {
                "$eq": [
                  "$monHoc.diemChu",
                  "F"
                ]
              },
              "then": 0
            }
          ],
          "default": null
        }
      },
      "monHoc.dat": {
        "$cond": [
          {
            "$eq": [
              "$monHoc.diemTK",
              null
            ]
          },
          null,
          {
            "$gte": [
              "$monHoc.diemTK",
              4.0
            ]
          }
        ]
      }
    }
  },
  {
    "$project": {
      "_id": 0,
      "maSV": 1,
      "hoTen": 1,
      "maLop": 1,
      "maDK": "$monHoc.maDK",
      "hinhThuc": "$monHoc.hinhThuc",
      "lanHoc": "$monHoc.lanHoc",
      "giangVien": "$monHoc.giangVien",
      "diem": "$monHoc.diem",
      "capNhatLuc": "$monHoc.capNhatLuc",
      "capNhatBoi": "$monHoc.capNhatBoi",
      "duDiem": "$monHoc.duDiem",
      "diemTK": "$monHoc.diemTK",
      "diemChu": "$monHoc.diemChu",
      "diemHe4": "$monHoc.diemHe4",
      "dat": "$monHoc.dat"
    }
  },
  {
    "$sort": {
      "maLop": 1,
      "maSV": 1
    }
  }
]
